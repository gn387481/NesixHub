    task.wait(0.35)
    ScreenGui:Destroy()
    loadstring(game:HttpGet("https://api.jnkie.com/api/v1/luascripts/public/7ccfe29120431e09ef4e854288a7711341ddf1904a5766479baad0022c76cffb/download"))()
end

-- Auto check saved key
task.spawn(function()
    local saved = loadSavedKey()
    if saved then
        KeyBox.Text = saved
        setStatus("Saved key found, checking...", Color3.fromRGB(200, 200, 100))
        
        local result = Junkie.check_key(saved)
        if result and result.valid then
            setStatus("Key valid! Loading...", Color3.fromRGB(100, 255, 140))
            getgenv().SCRIPT_KEY = saved
            task.wait(0.5)
            loadScript()
        else
            setStatus("Saved key is invalid", Color3.fromRGB(255, 120, 120))
            deleteSavedKey()
        end
    end
end)

GetKeyButton.MouseButton1Click:Connect(function()
    setStatus("Getting key link...", Color3.fromRGB(200, 200, 100))
    local link = Junkie.get_key_link()
    if link then
        if setclipboard then
            setclipboard(link)
            setStatus("Key link copied to clipboard!", Color3.fromRGB(100, 255, 140))
        else
            setStatus("Link copied", Color3.fromRGB(100, 255, 140))
        end
    else
        setStatus("Failed to get key link", Color3.fromRGB(255, 100, 100))
    end
end)

CheckButton.MouseButton1Click:Connect(function()
    local key = KeyBox.Text:gsub("%s+", "")
    if key == "" then
        setStatus("Please enter a key", Color3.fromRGB(255, 120, 120))
        return
    end

    setStatus("Checking key...", Color3.fromRGB(200, 200, 100))
    
    local result = Junkie.check_key(key)
    
    if result and result.valid then
        setStatus("Key valid! Loading...", Color3.fromRGB(100, 255, 140))
        saveKey(key)
        getgenv().SCRIPT_KEY = key
        task.wait(0.5)
        loadScript()
    else
        local msg = (result and (result.error or result.message)) or "Invalid key"
        setStatus(tostring(msg), Color3.fromRGB(255, 100, 100))
    end
end)

KeyBox.FocusLost:Connect(function(enter)
    if enter then
        CheckButton.MouseButton1Click:Fire()
    end
end)

-- Drag
local dragging, dragInput, dragStart, startPos
Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

Main.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

