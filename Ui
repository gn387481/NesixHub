--[[
    Nesix UI Library
    Full Version
]]

local NesixUI = {}
NesixUI.__index = NesixUI

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local Theme = {
    Background = Color3.fromRGB(14, 14, 18),
    Card = Color3.fromRGB(24, 24, 30),
    Sidebar = Color3.fromRGB(18, 18, 24),
    Accent = Color3.fromRGB(148, 90, 255),
    Text = Color3.fromRGB(245, 245, 250),
    TextDim = Color3.fromRGB(150, 150, 165),
    ToggleOff = Color3.fromRGB(45, 45, 55),
    SliderBg = Color3.fromRGB(40, 40, 50),
    InputBg = Color3.fromRGB(35, 35, 45)
}

local Icons = {
    Home = "rbxassetid://7733960981",
    Visuals = "rbxassetid://7733964719",
    Worlds = "rbxassetid://7734053495",
    Misc = "rbxassetid://7734054640",
    Settings = "rbxassetid://7734056603"
}

-- Notification System
local function Notify(title, text, duration)
    duration = duration or 3
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 280, 0, 70)
    notif.Position = UDim2.new(1, -300, 1, -90)
    notif.BackgroundColor3 = Theme.Card
    notif.BorderSizePixel = 0
    notif.Parent = CoreGui:FindFirstChild("NesixUI") or CoreGui
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 12)

    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = Theme.Accent
    stroke.Thickness = 1.5

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -20, 0, 24)
    t.Position = UDim2.new(0, 12, 0, 8)
    t.BackgroundTransparency = 1
    t.Text = title
    t.TextColor3 = Theme.Text
    t.Font = Enum.Font.GothamBold
    t.TextSize = 14
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = notif

    local d = Instance.new("TextLabel")
    d.Size = UDim2.new(1, -20, 0, 28)
    d.Position = UDim2.new(0, 12, 0, 32)
    d.BackgroundTransparency = 1
    d.Text = text
    d.TextColor3 = Theme.TextDim
    d.Font = Enum.Font.Gotham
    d.TextSize = 12
    d.TextXAlignment = Enum.TextXAlignment.Left
    d.TextWrapped = true
    d.Parent = notif

    task.delay(duration, function()
        notif:Destroy()
    end)
end

function NesixUI:Notify(title, text, duration)
    Notify(title, text, duration)
end

function NesixUI:CreateWindow(config)
    config = config or {}
    local Title = config.Title or "Nesix UI"
    local SubTitle = config.SubTitle or ""
    local Size = config.Size or UDim2.new(0, 720, 0, 480)

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "NesixUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = CoreGui

    local Main = Instance.new("Frame")
    Main.Size = Size
    Main.Position = UDim2.new(0.5, -Size.X.Offset/2, 0.5, -Size.Y.Offset/2)
    Main.BackgroundColor3 = Theme.Background
    Main.BorderSizePixel = 0
    Main.ClipsDescendants = true
    Main.Parent = ScreenGui
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 16)

    local Stroke = Instance.new("UIStroke", Main)
    Stroke.Color = Theme.Accent
    Stroke.Thickness = 2.2

    local Sidebar = Instance.new("Frame")
    Sidebar.Size = UDim2.new(0, 64, 1, 0)
    Sidebar.BackgroundColor3 = Theme.Sidebar
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main
    Instance.new("UICorner", Sidebar).CornerRadius = UDim.new(0, 16)

    local SideFix = Instance.new("Frame")
    SideFix.Size = UDim2.new(0, 20, 1, 0)
    SideFix.Position = UDim2.new(1, -20, 0, 0)
    SideFix.BackgroundColor3 = Theme.Sidebar
    SideFix.BorderSizePixel = 0
    SideFix.Parent = Sidebar

    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, -70, 0, 52)
    TopBar.Position = UDim2.new(0, 70, 0, 0)
    TopBar.BackgroundTransparency = 1
    TopBar.Parent = Main

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(0, 320, 0, 24)
    TitleLabel.Position = UDim2.new(0, 12, 0, 8)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = Title
    TitleLabel.TextColor3 = Theme.Text
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 18
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Parent = TopBar

    local SubLabel = Instance.new("TextLabel")
    SubLabel.Size = UDim2.new(0, 320, 0, 18)
    SubLabel.Position = UDim2.new(0, 12, 0, 30)
    SubLabel.BackgroundTransparency = 1
    SubLabel.Text = SubTitle
    SubLabel.TextColor3 = Theme.TextDim
    SubLabel.Font = Enum.Font.Gotham
    SubLabel.TextSize = 12
    SubLabel.TextXAlignment = Enum.TextXAlignment.Left
    SubLabel.Parent = TopBar

    -- Dragging
    local dragging, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    TopBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local Window = {
        Main = Main,
        Sidebar = Sidebar,
        Pages = {},
        TabCount = 0
    }

    function Window:CreateTab(name, icon)
        self.TabCount += 1
        local index = self.TabCount

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 46, 0, 46)
        btn.Position = UDim2.new(0.5, -23, 0, 18 + (index-1)*58)
        btn.BackgroundColor3 = (index == 1) and Theme.Accent or Color3.fromRGB(30, 30, 38)
        btn.Text = ""
        btn.Parent = self.Sidebar
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

        local img = Instance.new("ImageLabel")
        img.Size = UDim2.new(0, 22, 0, 22)
        img.Position = UDim2.new(0.5, -11, 0.5, -11)
        img.BackgroundTransparency = 1
        img.Image = icon or Icons.Home
        img.ImageColor3 = Color3.fromRGB(255, 255, 255)
        img.Parent = btn

        local page = Instance.new("Frame")
        page.Size = UDim2.new(1, -80, 1, -70)
        page.Position = UDim2.new(0, 74, 0, 58)
        page.BackgroundTransparency = 1
        page.Visible = (index == 1)
        page.Parent = self.Main
        self.Pages[name] = page

        btn.MouseButton1Click:Connect(function()
            for n, p in pairs(self.Pages) do
                p.Visible = (n == name)
            end
            for _, b in pairs(self.Sidebar:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
                end
            end
            btn.BackgroundColor3 = Theme.Accent
        end)

        local Tab = { Page = page }

        function Tab:CreateSection(title, side, y, height)
            side = side or "Left"
            local card = Instance.new("Frame")
            card.Size = UDim2.new(0.48, -6, 0, height or 260)
            card.Position = side == "Left" and UDim2.new(0, 0, 0, y or 0) or UDim2.new(0.52, 0, 0, y or 0)
            card.BackgroundColor3 = Theme.Card
            card.BorderSizePixel = 0
            card.Parent = self.Page
            Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -20, 0, 26)
            label.Position = UDim2.new(0, 12, 0, 8)
            label.BackgroundTransparency = 1
            label.Text = title
            label.TextColor3 = Theme.Text
            label.Font = Enum.Font.GothamBold
            label.TextSize = 14
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = card

            local Section = { Card = card, Y = 42 }

            function Section:CreateToggle(text, default, callback)
                local holder = Instance.new("Frame")
                holder.Size = UDim2.new(1, -24, 0, 28)
                holder.Position = UDim2.new(0, 12, 0, self.Y)
                holder.BackgroundTransparency = 1
                holder.Parent = self.Card

                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, -50, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = text
                lbl.TextColor3 = Theme.Text
                lbl.Font = Enum.Font.Gotham
                lbl.TextSize = 13
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = holder

                local toggle = Instance.new("TextButton")
                toggle.Size = UDim2.new(0, 42, 0, 22)
                toggle.Position = UDim2.new(1, -44, 0.5, -11)
                toggle.BackgroundColor3 = default and Theme.Accent or Theme.ToggleOff
                toggle.Text = ""
                toggle.Parent = holder
                Instance.new("UICorner", toggle).CornerRadius = UDim.new(1, 0)

                local circle = Instance.new("Frame")
                circle.Size = UDim2.new(0, 16, 0, 16)
                circle.Position = default and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
                circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                circle.Parent = toggle
                Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

                local state = default or false
                toggle.MouseButton1Click:Connect(function()
                    state = not state
                    toggle.BackgroundColor3 = state and Theme.Accent or Theme.ToggleOff
                    circle.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
                    if callback then callback(state) end
                end)

                self.Y += 36
                return toggle
            end

            function Section:CreateButton(text, callback)
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -24, 0, 34)
                btn.Position = UDim2.new(0, 12, 0, self.Y)
                btn.BackgroundColor3 = Theme.Accent
                btn.Text = text
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                btn.Font = Enum.Font.GothamBold
                btn.TextSize = 13
                btn.Parent = self.Card
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
                btn.MouseButton1Click:Connect(function()
                    if callback then callback() end
                end)
                self.Y += 42
                return btn
            end

            function Section:CreateLabel(text)
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, -24, 0, 22)
                lbl.Position = UDim2.new(0, 12, 0, self.Y)
                lbl.BackgroundTransparency = 1
                lbl.Text = text
                lbl.TextColor3 = Theme.TextDim
                lbl.Font = Enum.Font.Gotham
                lbl.TextSize = 12
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = self.Card
                self.Y += 28
                return lbl
            end

            function Section:CreateParagraph(text)
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, -24, 0, 40)
                lbl.Position = UDim2.new(0, 12, 0, self.Y)
                lbl.BackgroundTransparency = 1
                lbl.Text = text
                lbl.TextColor3 = Theme.TextDim
                lbl.Font = Enum.Font.Gotham
                lbl.TextSize = 12
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.TextYAlignment = Enum.TextYAlignment.Top
                lbl.TextWrapped = true
                lbl.Parent = self.Card
                self.Y += 46
                return lbl
            end

            function Section:CreateTextBox(placeholder, callback)
                local box = Instance.new("TextBox")
                box.Size = UDim2.new(1, -24, 0, 34)
                box.Position = UDim2.new(0, 12, 0, self.Y)
                box.BackgroundColor3 = Theme.InputBg
                box.Text = ""
                box.PlaceholderText = placeholder or "Type here..."
                box.PlaceholderColor3 = Theme.TextDim
                box.TextColor3 = Theme.Text
                box.Font = Enum.Font.Gotham
                box.TextSize = 13
                box.ClearTextOnFocus = false
                box.Parent = self.Card
                Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

                box.FocusLost:Connect(function(enter)
                    if enter and callback then
                        callback(box.Text)
                    end
                end)

                self.Y += 42
                return box
            end

            function Section:CreateSlider(text, min, max, default, callback)
                local holder = Instance.new("Frame")
                holder.Size = UDim2.new(1, -24, 0, 50)
                holder.Position = UDim2.new(0, 12, 0, self.Y)
                holder.BackgroundTransparency = 1
                holder.Parent = self.Card

                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, 0, 0, 18)
                lbl.BackgroundTransparency = 1
                lbl.Text = text .. ": " .. tostring(default)
                lbl.TextColor3 = Theme.Text
                lbl.Font = Enum.Font.Gotham
                lbl.TextSize = 13
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = holder

                local bar = Instance.new("Frame")
                bar.Size = UDim2.new(1, 0, 0, 8)
                bar.Position = UDim2.new(0, 0, 0, 28)
                bar.BackgroundColor3 = Theme.SliderBg
                bar.BorderSizePixel = 0
                bar.Parent = holder
                Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

                local fill = Instance.new("Frame")
                fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
                fill.BackgroundColor3 = Theme.Accent
                fill.BorderSizePixel = 0
                fill.Parent = bar
                Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

                local sliding = false
                bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                        local value = math.floor(min + (max - min) * rel)
                        fill.Size = UDim2.new(rel, 0, 1, 0)
                        lbl.Text = text .. ": " .. value
                        if callback then callback(value) end
                    end
                end)

                self.Y += 58
                return holder
            end

            function Section:CreateKeybind(text, default, callback)
                local holder = Instance.new("Frame")
                holder.Size = UDim2.new(1, -24, 0, 32)
                holder.Position = UDim2.new(0, 12, 0, self.Y)
                holder.BackgroundTransparency = 1
                holder.Parent = self.Card

                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(0.6, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = text
                lbl.TextColor3 = Theme.Text
                lbl.Font = Enum.Font.Gotham
                lbl.TextSize = 13
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = holder

                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(0.35, 0, 0, 26)
                btn.Position = UDim2.new(0.65, 0, 0.5, -13)
                btn.BackgroundColor3 = Theme.InputBg
                btn.Text = default or "None"
                btn.TextColor3 = Theme.Text
                btn.Font = Enum.Font.Gotham
                btn.TextSize = 12
                btn.Parent = holder
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

                local waiting = false
                btn.MouseButton1Click:Connect(function()
                    waiting = true
                    btn.Text = "..."
                end)

                local connection
                connection = UserInputService.InputBegan:Connect(function(input)
                    if waiting and input.UserInputType == Enum.UserInputType.Keyboard then
                        local key = input.KeyCode.Name
                        btn.Text = key
                        waiting = false
                        if callback then callback(key) end
                    end
                end)

                self.Y += 40
                return btn
            end

            function Section:CreateColorPicker(text, default, callback)
                local holder = Instance.new("Frame")
                holder.Size = UDim2.new(1, -24, 0, 32)
                holder.Position = UDim2.new(0, 12, 0, self.Y)
                holder.BackgroundTransparency = 1
                holder.Parent = self.Card

                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(0.7, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = text
                lbl.TextColor3 = Theme.Text
                lbl.Font = Enum.Font.Gotham
                lbl.TextSize = 13
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = holder

                local preview = Instance.new("TextButton")
                preview.Size = UDim2.new(0, 28, 0, 28)
                preview.Position = UDim2.new(1, -32, 0.5, -14)
                preview.BackgroundColor3 = default or Theme.Accent
                preview.Text = ""
                preview.Parent = holder
                Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 6)

                -- Simple color cycle for now
                local colors = {
                    Color3.fromRGB(148, 90, 255),
                    Color3.fromRGB(255, 80, 80),
                    Color3.fromRGB(80, 200, 120),
                    Color3.fromRGB(80, 160, 255),
                    Color3.fromRGB(255, 180, 50),
                    Color3.fromRGB(255, 255, 255)
                }
                local index = 1
                preview.MouseButton1Click:Connect(function()
                    index = index % #colors + 1
                    preview.BackgroundColor3 = colors[index]
                    if callback then callback(colors[index]) end
                end)

                self.Y += 40
                return preview
            end

            return Section
        end

        return Tab
    end

    return Window
end

return NesixUI
